    {
      "questionBodyText": "細胞膜蛋白質の機能でないのはどれか。",
      "qualificationName": "柔道整復師",
      "examLabel": "第8回（2000年） 午前問題",
      "questionLabel": "問31",
      "questionType": "true_false",
