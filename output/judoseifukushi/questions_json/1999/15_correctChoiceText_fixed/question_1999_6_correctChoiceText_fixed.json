    "original_question_id": "bc0cdfcd68ce1de1",
    "questionImageStorageUrls": [],
    "questionIntent": "select_correct",
    "explanation_common_prefix": [],
    "explanation_common_prefix_inferred_correct_choice": 4,
    "explanation_common_summary": [],
