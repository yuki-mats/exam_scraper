    {
      "questionBodyText": "細胞内に最も高濃度に存在する陽イオンはどれか。",
      "qualificationName": "柔道整復師",
      "examLabel": "第9回（2001年） 午前問題",
      "questionLabel": "問32",
      "questionType": "true_false",
      "choiceTextList": [
        "カリウム",
